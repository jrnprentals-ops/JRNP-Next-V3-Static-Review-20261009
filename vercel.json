{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/quote",
      "destination": "https://jrnp-backend.vercel.app/api/quote"
    },
    {
      "source": "/api/bookings",
      "destination": "https://jrnp-backend.vercel.app/api/bookings"
    },
    {
      "source": "/api/support/messages",
      "destination": "https://jrnp-backend.vercel.app/api/support/messages"
    },
    {
      "source": "/api/properties/:id/calendar",
      "destination": "https://jrnp-backend.vercel.app/api/properties/:id/calendar"
    }
  ]
}
